# Copy to .env.local (ignored by git) and fill in real values.
# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your-tinyfish-api-key

# Procurement provider: "sample" (default) uses a local fixture and spends no
# TinyFish credits. Set to "live" to browse real supplier sites via TinyFish.
PROCUREMENT_MODE=sample

# Optional: where the workspace SQLite database lives (default ./data/workplace.db)
# WORKPLACE_DB_PATH=./data/workplace.db

# --- Auth0 (Regular Web Application) ---------------------------------------
# Real values go in .env.local only. Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=replace-with-64-hex-characters
APP_BASE_URL=http://localhost:3001

# Offices created before sign-in existed (including the migrated demo data)
# are given to the user who signs in with this *verified* email.
WORKPLACE_DEMO_OWNER_EMAIL=you@example.com
