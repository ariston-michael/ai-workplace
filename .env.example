# Copy to .env.local (ignored by git) and fill in real values.
# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your-tinyfish-api-key

# Procurement provider: "sample" (default) uses a local fixture and spends no
# TinyFish credits. Set to "live" to browse real supplier sites via TinyFish.
PROCUREMENT_MODE=sample

# Optional: where the workspace SQLite database lives (default ./data/workplace.db)
# WORKPLACE_DB_PATH=./data/workplace.db
